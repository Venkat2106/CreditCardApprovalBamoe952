  <decision name="IsEligible" id="_1DBB53DA-9D4A-4E75-BCAD-17AFE518CFAE">
    <variable id="_96FAD5C1-B3B5-4425-9550-791B5E709781" typeRef="string" name="IsEligible" />
    <informationRequirement id="_67435B5F-B9A1-4530-AA16-45B933520409">
      <requiredDecision href="#_6E225F27-0CE6-4BED-BBC1-B8A7AB8F332F" />
    </informationRequirement>
    <literalExpression id="_DA35546F-6AB9-48BD-85B9-0765E153BE83" typeRef="string" label="IsEligible">
      <text>if Eligibility Score Calculation &lt; 20 then &quot;rejected&quot;
	else if Eligibility Score Calculation &lt; 60 then &quot;manual&quot;
	else &quot;approved&quot;
</text>
    </literalExpression>
  </decision>
